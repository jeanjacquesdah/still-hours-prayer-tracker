# Copy this file to .env.local (for local dev) and fill in the values from
# your Supabase project: Project Settings -> API.
#
# These are safe to expose in a client-side app -- the anon key only works
# within the permissions granted by the Row Level Security policies defined
# in supabase/schema.sql.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
